rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function fields(data, required, optional) {
      return data.keys().hasAll(required)
        && data.keys().hasOnly(required.concat(optional));
    }

    function nonBlank(value) {
      return value is string
        // Unicode separators plus the whitespace controls used by Kotlin isBlank.
        && !value.matches('[\\x{0009}-\\x{000D}\\x{001C}-\\x{001F}\\p{Z}]*');
    }

    function validId(value) {
      return nonBlank(value)
        && value != '.'
        && value != '..'
        && value.matches('[^/]+');
    }

    function daysInMonth(year, month) {
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      return month == 2
        ? (leap ? 29 : 28)
        : (month in [4, 6, 9, 11] ? 30 : 31);
    }

    function validDateParts(year, month, day) {
      return month >= 1 && month <= 12
        && day >= 1 && day <= daysInMonth(year, month);
    }

    function validDate(value) {
      // Preserve the existing YYYY-MM-DD format without adding a year cutoff.
      return value is string
        && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && validDateParts(int(value[0:4]), int(value[5:7]), int(value[8:10]));
    }

    function supportedCollection(name) {
      return name in [
        'accounts', 'categories', 'incomeSources', 'expectedPayments',
        'schedules', 'occurrences', 'transactions', 'goals', 'goalPlans',
        'budgets', 'rateSnapshots', 'cryptoPositions'
      ];
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function accountPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/accounts/$(id);
    }

    function eventPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/transactions/$(id);
    }

    function categoryPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/categories/$(id);
    }

    function validDefaultProfile(data) {
      return fields(
          data,
          [
            'baseCurrency', 'timeZone', 'weekStartsOn',
            'onboardingCompleted', 'hideBalances', 'remindersEnabled',
            'schemaVersion', 'createdAt', 'updatedAt'
          ],
          []
        )
        && data.baseCurrency == 'LKR'
        && data.timeZone == 'Asia/Colombo'
        && data.weekStartsOn is int
        && data.weekStartsOn == 1
        && data.onboardingCompleted == false
        && data.hideBalances == false
        && data.remindersEnabled == true
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validAccount(data) {
      return fields(
          data,
          [
            'name', 'type', 'currencyCode', 'assetClass', 'scale',
            'includeInEverydayPool', 'openingTransactionId', 'openedOn',
            'createdAt', 'updatedAt', 'revision'
          ],
          ['institutionLabel']
        )
        && nonBlank(data.name)
        && data.type in ['CASH', 'BANK', 'FIAT_WALLET']
        && data.currencyCode == 'LKR'
        && data.assetClass == 'FIAT'
        && data.scale is int
        && data.scale == 2
        && data.includeInEverydayPool is bool
        && validId(data.openingTransactionId)
        && validDate(data.openedOn)
        && (
          !('institutionLabel' in data)
          || nonBlank(data.institutionLabel)
        )
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision is int
        && data.revision == 0;
    }

    function validCategory(data) {
      return fields(
          data,
          [
            'name', 'defaultCommitmentClass', 'sortOrder',
            'createdAt', 'updatedAt', 'revision'
          ],
          ['iconKey']
        )
        && nonBlank(data.name)
        && data.defaultCommitmentClass in [
          'COMMITTED', 'DISCRETIONARY', 'UNPLANNED_ESSENTIAL'
        ]
        && data.sortOrder is int
        && data.sortOrder >= -2147483648
        && data.sortOrder <= 2147483647
        && (
          !('iconKey' in data)
          || data.iconKey is string
        )
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision is int
        && data.revision == 0;
    }

    function incomeSourcePath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/incomeSources/$(id);
    }

    function validIncomeSource(data) {
      return fields(
          data,
          ['name', 'kind', 'createdAt', 'updatedAt', 'revision'],
          ['defaultAccountId', 'defaultCurrencyCode']
        )
        && nonBlank(data.name)
        && data.kind in ['SALARY', 'FREELANCE', 'ADSENSE', 'CRYPTO', 'OTHER']
        && (
          !('defaultAccountId' in data)
          || validId(data.defaultAccountId)
        )
        && (
          !('defaultCurrencyCode' in data)
          || data.defaultCurrencyCode == 'LKR'
        )
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision is int
        && data.revision == 0;
    }

    function validExpectedPayment(uid, data) {
      let source = incomeSourcePath(uid, data.incomeSourceId);
      return fields(
          data,
          [
            'incomeSourceId', 'projectLabel', 'currencyCode', 'amountDueMinor', 'dueDate',
            'state', 'receivedAmountMinor', 'createdAt', 'updatedAt', 'revision'
          ],
          ['milestoneLabel', 'clientLabel', 'notes']
        )
        && validId(data.incomeSourceId)
        && nonBlank(data.projectLabel)
        && data.currencyCode == 'LKR'
        && data.amountDueMinor is int
        && data.amountDueMinor > 0
        && data.amountDueMinor <= 100000000000
        && data.receivedAmountMinor is int
        && data.receivedAmountMinor == 0
        && validDate(data.dueDate)
        && data.state == 'ACTIVE'
        && (!('milestoneLabel' in data) || nonBlank(data.milestoneLabel))
        && (!('clientLabel' in data) || nonBlank(data.clientLabel))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision is int
        && data.revision == 0
        && exists(source)
        && get(source).data.get('archivedAt', null) == null
        && (!('defaultCurrencyCode' in get(source).data)
          || get(source).data.defaultCurrencyCode == 'LKR');
    }

    function validMovement(movement) {
      return fields(
          movement,
          ['accountId', 'currencyCode', 'assetClass', 'amountMinor'],
          []
        )
        && validId(movement.accountId)
        && movement.currencyCode == 'LKR'
        && movement.assetClass == 'FIAT'
        && movement.amountMinor is int
        && movement.amountMinor >= -100000000000
        && movement.amountMinor <= 100000000000;
    }

    function validEvent(id, data) {
      return fields(
          data,
          [
            'operationId', 'kind', 'status',
            'occurredAt', 'occurredLocalDate', 'recordedTimeZone',
            'clientCreatedAt', 'createdAt', 'schemaVersion', 'revision',
            'accountIds', 'categoryIds', 'goalIds', 'incomeSourceIds',
            'movements', 'components', 'reservationEffects', 'valuations'
          ],
          ['note', 'merchantLabel', 'expectedPaymentId', 'occurrenceId']
        )
        && validId(id)
        && data.operationId == id
        && data.kind in ['OPENING', 'EXPENSE', 'INCOME']
        && (!('occurrenceId' in data) || (data.kind == 'EXPENSE' && validId(data.occurrenceId)))
        && (
          !('expectedPaymentId' in data)
          || (data.kind == 'INCOME' && validId(data.expectedPaymentId))
        )
        && data.status == 'POSTED'
        && data.occurredAt is timestamp
        && validDate(data.occurredLocalDate)
        && nonBlank(data.recordedTimeZone)
        && data.clientCreatedAt is timestamp
        && data.createdAt == request.time
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision == 0
        && data.movements is list
        && data.movements.size() == 1
        && validMovement(data.movements[0])
        && data.accountIds == [data.movements[0].accountId]
        && data.components is list
        && data.categoryIds is list
        && data.goalIds == []
        && data.reservationEffects == []
        && data.valuations == []
        && (
          !('note' in data)
          || (data.note is string && data.note.size() <= 1000)
        )
        && (
          !('merchantLabel' in data)
          || (
            data.merchantLabel is string
            && data.merchantLabel.size() <= 1000
          )
        );
    }

    function validNewAccount(uid, id, data) {
      let opening = eventPath(uid, data.openingTransactionId);
      let afterOpening = getAfter(opening).data;

      return validAccount(data)
        && validId(id)
        && getAfter(profilePath(uid)).data.baseCurrency == 'LKR'
        && !exists(opening)
        && afterOpening.operationId == data.openingTransactionId
        && afterOpening.kind == 'OPENING'
        && afterOpening.status == 'POSTED'
        && afterOpening.createdAt == request.time
        && afterOpening.accountIds == [id]
        && afterOpening.movements.size() == 1
        && afterOpening.movements[0].accountId == id
        && afterOpening.occurredLocalDate == data.openedOn;
    }

    function validOpening(uid, id, data) {
      let account = accountPath(uid, data.movements[0].accountId);
      let afterAccount = getAfter(account).data;

      return data.components == []
        && data.categoryIds == []
        && data.incomeSourceIds == []
        && !exists(account)
        && afterAccount.openingTransactionId == id
        && afterAccount.openedOn == data.occurredLocalDate
        && afterAccount.currencyCode == 'LKR'
        && afterAccount.assetClass == 'FIAT'
        && afterAccount.scale == 2
        && afterAccount.createdAt == request.time;
    }

    function validExpense(uid, data) {
      let movement = data.movements[0];
      let component = data.components[0];
      let account = accountPath(uid, movement.accountId);
      let category = categoryPath(uid, component.categoryId);

      return data.components.size() == 1
        && fields(
          component,
          ['nature', 'amountLkrMinor', 'categoryId', 'commitmentClass'],
          []
        )
        && component.nature == 'SPENDING'
        && component.amountLkrMinor is int
        && component.amountLkrMinor > 0
        && component.amountLkrMinor <= 100000000000
        && validId(component.categoryId)
        && component.commitmentClass in [
          'COMMITTED', 'DISCRETIONARY', 'UNPLANNED_ESSENTIAL'
        ]
        && data.categoryIds == [component.categoryId]
        && data.incomeSourceIds == []
        && movement.amountMinor == -component.amountLkrMinor
        && exists(account)
        && get(account).data.currencyCode == 'LKR'
        && get(account).data.assetClass == 'FIAT'
        && get(account).data.scale == 2
        && get(account).data.get('archivedAt', null) == null
        && exists(category)
        && get(category).data.get('archivedAt', null) == null;
    }

    function validIncome(uid, data) {
      let movement = data.movements[0];
      let component = data.components[0];
      let account = accountPath(uid, movement.accountId);
      let source = incomeSourcePath(uid, component.incomeSourceId);
      return data.components.size() == 1
        && fields(component, ['nature', 'amountLkrMinor', 'incomeSourceId'], [])
        && component.nature == 'EARNING'
        && component.amountLkrMinor is int
        && component.amountLkrMinor > 0
        && component.amountLkrMinor <= 100000000000
        && validId(component.incomeSourceId)
        && data.categoryIds == []
        && data.incomeSourceIds == [component.incomeSourceId]
        && !('merchantLabel' in data)
        && movement.amountMinor == component.amountLkrMinor
        && exists(account)
        && get(account).data.currencyCode == 'LKR'
        && get(account).data.assetClass == 'FIAT'
        && get(account).data.scale == 2
        && get(account).data.get('archivedAt', null) == null
        && exists(source)
        && get(source).data.get('archivedAt', null) == null
        && (!('defaultCurrencyCode' in get(source).data) || get(source).data.defaultCurrencyCode == 'LKR');
    }

    function validIncomeExpectedLink(uid, transactionId, data) {
      return !('expectedPaymentId' in data)
        || (
          validId(data.expectedPaymentId)
          && expectedPaymentLinkExists(uid, transactionId, data)
        );
    }

    function expectedPaymentLinkExists(uid, transactionId, data) {
      let payment = /databases/$(database)/documents/users/$(uid)/expectedPayments/$(data.expectedPaymentId);
      return exists(payment)
        && validExpectedPaymentLinkUpdate(uid, transactionId, data, payment);
    }

    function validExpectedPaymentLinkUpdate(uid, transactionId, data, payment) {
      let beforePayment = get(payment).data;
      let afterPayment = getAfter(payment).data;
      return beforePayment.state == 'ACTIVE'
        && afterPayment.state == 'ACTIVE'
        && beforePayment.incomeSourceId == data.components[0].incomeSourceId
        && afterPayment.incomeSourceId == beforePayment.incomeSourceId
        && beforePayment.currencyCode == data.movements[0].currencyCode
        && beforePayment.amountDueMinor is int
        && beforePayment.get('receivedAmountMinor', 0) is int
        && afterPayment.receivedAmountMinor is int
        && afterPayment.receivedAmountMinor == beforePayment.get('receivedAmountMinor', 0) + data.movements[0].amountMinor
        && afterPayment.receivedAmountMinor <= beforePayment.amountDueMinor
        && afterPayment.lastReceiptOperationId == transactionId
        && afterPayment.revision == beforePayment.revision + 1
        && afterPayment.updatedAt == request.time
        && !exists(eventPath(uid, transactionId));
    }

    function validExpectedReceiptUpdate(uid, paymentId) {
      return 'lastReceiptOperationId' in request.resource.data
        && validId(request.resource.data.lastReceiptOperationId)
        && validExpectedReceiptUpdateForId(
          uid, paymentId, request.resource.data.lastReceiptOperationId
        );
    }

    function validExpectedReceiptUpdateForId(uid, paymentId, receiptId) {
      let receiptPath = eventPath(uid, receiptId);
      let receipt = getAfter(receiptPath).data;
      return resource.data.state == 'ACTIVE'
        && request.resource.data.state == 'ACTIVE'
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && resource.data.get('receivedAmountMinor', 0) is int
        && request.resource.data.receivedAmountMinor is int
        && !exists(receiptPath)
        && receipt.operationId == receiptId
        && receipt.kind == 'INCOME'
        && receipt.expectedPaymentId == paymentId
        && validEvent(receiptId, receipt)
        && validIncome(uid, receipt)
        && receipt.incomeSourceIds == [resource.data.incomeSourceId]
        && receipt.movements.size() == 1
        && receipt.movements[0].currencyCode == resource.data.currencyCode
        && request.resource.data.receivedAmountMinor == resource.data.get('receivedAmountMinor', 0) + receipt.movements[0].amountMinor
        && request.resource.data.receivedAmountMinor <= resource.data.amountDueMinor
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedAmountMinor', 'lastReceiptOperationId', 'updatedAt', 'revision'
        ]);
    }

    // Budgets are immutable records in the existing collection. IDs are retained
    // by the caller for retries; updates, archival and uniqueness are deferred.
    function validNewBudget(uid, data) {
      return fields(data, [
          'scope', 'periodType', 'limitLkrMinor', 'effectiveFrom',
          'rolloverEnabled', 'state', 'createdAt', 'updatedAt', 'revision'
        ], ['effectiveTo', 'categoryId'])
        && data.scope in ['OVERALL_DISCRETIONARY', 'CATEGORY_DISCRETIONARY']
        && data.periodType in ['WEEKLY', 'MONTHLY']
        && data.limitLkrMinor is int
        && data.limitLkrMinor > 0 && data.limitLkrMinor <= 100000000000
        && validDate(data.effectiveFrom)
        && (!('effectiveTo' in data) || (validDate(data.effectiveTo) && data.effectiveTo >= data.effectiveFrom))
        && data.rolloverEnabled == false
        && data.state == 'ACTIVE'
        && data.revision is int && data.revision == 0
        && data.createdAt == request.time && data.updatedAt == request.time
        && (data.scope == 'OVERALL_DISCRETIONARY'
          ? !('categoryId' in data)
          : (validId(data.categoryId) && exists(categoryPath(uid, data.categoryId))));
    }

    // One-way lifecycle transition only; all financial and creation fields stay
    // byte-for-byte equal. Income/receipts and opening events remain immutable.
    function validExpenseVoid() {
      let before = resource.data;
      let after = request.resource.data;
      return before.kind == 'EXPENSE' && before.status == 'POSTED'
        && before.revision == 0
        && after.status == 'VOIDED'
        && after.revision is int && after.revision == before.revision + 1
        && after.updatedAt == request.time
        && fields(after.voidMetadata, ['voidedAt', 'voidReason'], [])
        && after.voidMetadata.voidedAt is timestamp
        && nonBlank(after.voidMetadata.voidReason) && after.voidMetadata.voidReason.size() <= 1000
        && after.diff(before).affectedKeys().hasOnly(['status', 'voidMetadata', 'updatedAt', 'revision']);
    }

    function billSchedulePath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/schedules/$(id);
    }

    function billOccurrencePath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/occurrences/$(id);
    }

    function validFirstMonthlyBill(uid, scheduleId, data) {
      return fields(data, [
          'kind', 'title', 'frequency', 'interval', 'anchorDate', 'timeZone',
          'expectedAmountMinor', 'currencyCode', 'amountMode', 'categoryId', 'commitmentClass',
          'activeFrom', 'paused', 'reminderLeadDays', 'createdAt', 'updatedAt', 'revision'
        ], [])
        && data.kind == 'COMMITMENT'
        && nonBlank(data.title) && data.title.size() <= 80
        && data.frequency == 'MONTHLY' && data.interval is int && data.interval == 1
        && validDate(data.anchorDate) && data.activeFrom == data.anchorDate
        && data.timeZone == 'Asia/Colombo' && data.currencyCode == 'LKR'
        && data.expectedAmountMinor is int && data.expectedAmountMinor > 0
        && data.expectedAmountMinor <= 100000000000 && data.amountMode == 'FIXED'
        && validId(data.categoryId) && data.commitmentClass == 'COMMITTED'
        && exists(categoryPath(uid, data.categoryId))
        && get(categoryPath(uid, data.categoryId)).data.get('archivedAt', null) == null
        && data.paused == false && data.reminderLeadDays is int && data.reminderLeadDays == 0
        && data.createdAt == request.time && data.updatedAt == request.time
        && data.revision is int && data.revision == 0
        && firstBillOccurrenceIsNew(uid, scheduleId + '_' + data.anchorDate);
    }

    function firstBillOccurrenceIsNew(uid, occurrenceId) {
      let path = billOccurrencePath(uid, occurrenceId);
      return !exists(path) && existsAfter(path);
    }

    function validRecurringBillDate(date, anchor) {
      let limit = daysInMonth(int(date[0:4]), int(date[5:7]));
      let anchorDay = int(anchor[8:10]);
      return int(date[8:10]) == (anchorDay <= limit ? anchorDay : limit);
    }

    function validBillOccurrence(uid, occurrenceId, data) {
      let path = billSchedulePath(uid, data.scheduleId);
      let schedule = getAfter(path).data;
      return fields(data, [
          'scheduleId', 'nominalDate', 'effectiveDueDate', 'kind', 'titleSnapshot',
          'expectedAmountMinor', 'currencyCode', 'timeZone', 'categoryId', 'commitmentClass',
          'state', 'createdAt', 'updatedAt', 'revision'
        ], [])
        && validDate(data.nominalDate)
        && occurrenceId == data.scheduleId + '_' + data.nominalDate
        && data.effectiveDueDate == data.nominalDate
        && (data.nominalDate == schedule.anchorDate
          ? !exists(path)
          : exists(path) && data.nominalDate > schedule.anchorDate
            && validRecurringBillDate(data.nominalDate, schedule.anchorDate))
        && data.kind == schedule.kind && data.titleSnapshot == schedule.title
        && data.expectedAmountMinor is int && data.expectedAmountMinor == schedule.expectedAmountMinor
        && data.currencyCode == schedule.currencyCode && data.timeZone == schedule.timeZone
        && data.categoryId == schedule.categoryId && data.commitmentClass == schedule.commitmentClass
        && data.state == 'OPEN' && data.revision is int && data.revision == 0
        && data.createdAt == request.time && data.updatedAt == request.time;
    }

    // The paid total is a projection of linked posted expenses. Both sides
    // of a payment or void must agree on the exact delta in the same commit.
    function validBillExpenseDelta(occurrenceId, before, after, expenseId, expense, direction) {
      let component = expense.components[0];
      return before.kind == 'COMMITMENT' && before.state == 'OPEN'
        && expense.kind == 'EXPENSE' && expense.occurrenceId == occurrenceId
        && component.categoryId == before.categoryId
        && component.commitmentClass == 'COMMITTED'
        && after.diff(before).affectedKeys().hasOnly([
          'paidAmountMinor', 'lastBillExpenseId', 'revision', 'updatedAt'
        ])
        && after.lastBillExpenseId == expenseId
        && after.revision is int && after.revision == before.revision + 1
        && after.updatedAt == request.time
        && after.paidAmountMinor is int && after.paidAmountMinor >= 0
        && after.paidAmountMinor <= before.expectedAmountMinor
        && after.paidAmountMinor == before.get('paidAmountMinor', 0) + direction * component.amountLkrMinor;
    }

    function validLinkedBillExpense(uid, expenseId, expense, direction) {
      let path = billOccurrencePath(uid, expense.occurrenceId);
      return validBillExpenseDelta(expense.occurrenceId, get(path).data, getAfter(path).data,
        expenseId, expense, direction);
    }

    function validBillPaymentUpdate(uid, occurrenceId) {
      let after = request.resource.data;
      let path = eventPath(uid, after.lastBillExpenseId);
      let expense = getAfter(path).data;
      return validId(after.lastBillExpenseId) && (
        (!exists(path) && expense.status == 'POSTED' && expense.createdAt == request.time
          && validBillExpenseDelta(occurrenceId, resource.data, after, after.lastBillExpenseId, expense, 1))
        || (exists(path) && get(path).data.status == 'POSTED' && expense.status == 'VOIDED'
          && expense.updatedAt == request.time
          && validBillExpenseDelta(occurrenceId, resource.data, after, after.lastBillExpenseId, expense, -1))
      );
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && validId(uid)
        && validDefaultProfile(request.resource.data);

      allow update, delete: if false;

      match /categories/{categoryId} {
        allow create: if isOwner(uid)
          && validId(categoryId)
          && validCategory(request.resource.data);

        allow update, delete: if false;
      }

      match /incomeSources/{sourceId} {
        allow get, list: if isOwner(uid);

        allow create: if isOwner(uid)
          && validId(sourceId)
          && validIncomeSource(request.resource.data);

        allow update, delete: if false;
      }

      match /expectedPayments/{paymentId} {
        allow get, list: if isOwner(uid);

        allow create: if isOwner(uid)
          && validId(paymentId)
          && validExpectedPayment(uid, request.resource.data);

        allow update: if isOwner(uid) && (
          validExpectedReceiptUpdate(uid, paymentId)
          || (
            resource.data.state == 'ACTIVE'
            && request.resource.data.state == 'CANCELLED'
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.cancelledAt == request.time
            && request.resource.data.updatedAt == request.time
            && validId(request.resource.data.cancellationOperationId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'state', 'cancelledAt', 'updatedAt', 'revision', 'cancellationOperationId'
            ])
          )
        );
        allow delete: if false;
      }

      match /schedules/{scheduleId} {
        allow create: if isOwner(uid) && validId(scheduleId)
          && validFirstMonthlyBill(uid, scheduleId, request.resource.data);
        allow update, delete: if false;
      }

      match /occurrences/{occurrenceId} {
        allow create: if isOwner(uid) && validId(occurrenceId)
          && validId(request.resource.data.scheduleId)
          && validBillOccurrence(uid, occurrenceId, request.resource.data);
        allow update: if isOwner(uid) && validBillPaymentUpdate(uid, occurrenceId);
        allow delete: if false;
      }

      match /budgets/{budgetId} {
        allow create: if isOwner(uid) && validId(budgetId)
          && validNewBudget(uid, request.resource.data);
        allow update, delete: if false;
      }

      match /accounts/{accountId} {
        allow create: if isOwner(uid)
          && validNewAccount(uid, accountId, request.resource.data);

        allow update, delete: if false;
      }

      match /transactions/{transactionId} {
        allow create: if isOwner(uid)
          && validEvent(transactionId, request.resource.data)
          && (
            (
              request.resource.data.kind == 'OPENING'
              && validOpening(uid, transactionId, request.resource.data)
            )
            || (
              request.resource.data.kind == 'EXPENSE'
              && validExpense(uid, request.resource.data)
              && (!('occurrenceId' in request.resource.data)
                || validLinkedBillExpense(uid, transactionId, request.resource.data, 1))
            )
            || (
              request.resource.data.kind == 'INCOME'
              && validIncome(uid, request.resource.data)
              && validIncomeExpectedLink(uid, transactionId, request.resource.data)
            )
          );

        allow update: if isOwner(uid) && validExpenseVoid()
          && (!('occurrenceId' in resource.data) || validLinkedBillExpense(uid, transactionId, resource.data, -1));
        allow delete: if false;
      }

      match /{collectionId}/{documentId} {
        allow read: if isOwner(uid)
          && supportedCollection(collectionId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
